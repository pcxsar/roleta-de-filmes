rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem está autenticado pelo próprio app (login anônimo automático)
    // pode ler ou escrever. Bloqueia acesso de fora/bots.
    match /sync/{docId} {
      allow read, write: if request.auth != null;
    }
    match /diario/{entryId} {
      allow read, write: if request.auth != null;
    }
  }
}
