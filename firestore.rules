rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem está autenticado pelo próprio app (login anônimo automático)
    // pode ler ou escrever. Bloqueia acesso de fora/bots.
    // Cobre todas as coleções do app (sync, diario, watchlist, e futuras)
    // sem precisar editar as regras de novo a cada nova aba/feature.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
